---
// Home: the hero, the hub (eight cells, each leading to its own page) and the
// way to start. The content lives on the pages the cells open (Stefan,
// 2026-11-16: a company page, not a portfolio).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HiveDashboard from '../components/hive/HiveDashboard.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ScoutChat from '../components/ScoutChat.astro';
---

<Base>
  <Header slot="header" />
  <Hero />
  <HiveDashboard />
  <Fragment slot="footer">
    <Footer />
    <StickyCta />
    <ScoutChat />
  </Fragment>
</Base>
