---
// A honeycomb where every cell is one project; choosing a cell opens a popup
// below the honeycomb with the project's five lines (ProjectDetails). Without
// JavaScript the popups show as a plain list under the honeycomb and each cell
// links to its entry.
//
// Declared copy of ManSe404/webpage@1adafb1
// website/src/components/hive/ProjectHive.astro (ADR 0007). Kept: the grid
// (four cells per row on desktop, two on phones, via src/lib/honeycomb.ts), the colours by field, the popup, the deep link
// (#<id>-<project> opens a project) and Escape. Changed: one last cell, the
// dashed "Not on the list?" 404 cell, whose popup leads to the contact page;
// seven cells per row on wide screens instead of six, so twelve projects and
// the 404 cell close into one comb (7 + 6); no type-of-work data and no
// relayout event (this site has no filters).
import type { Project } from '../../lib/projects';
import { withBase } from '../../lib/url';
import ProjectDetails from './ProjectDetails.astro';
import { cols, place, tracks } from '../../lib/honeycomb';

interface Props {
  id: string;
  projects: Project[];
}

const { id, projects } = Astro.props;

// "RiskFocus — Risk Summarizer" -> "RiskFocus"; titles without a dash stay whole.
const shortTitle = (title: string) => title.split(' — ')[0];

const items = projects.map((p) => ({
  key: `${id}-${p.id}`,
  project: p,
  short: shortTitle(p.data.title),
  field: p.data.category,
  tone: /AI|Vision/.test(p.data.category) ? 'ai' : /Data|Machine/.test(p.data.category) ? 'bio' : 'sw',
}));
const missing = `${id}-not-on-the-list`;
const n = items.length + 1;
const at = (i: number) => {
  const w = place(i, 7);
  const d = place(i, 4);
  const m = place(i, 2);
  return `--rw:${w.row};--cw:${w.col};--rd:${d.row};--cd:${d.col};--rp:${m.row};--cp:${m.col}`;
};
---

<div class="phive" data-phive style={`--tracks-w:${tracks(n, 7)};--tracks-d:${tracks(n, 4)};--tracks-p:${tracks(n, 2)};--cols-w:${cols(n, 7)};--cols-d:${cols(n, 4)};--cols-p:${cols(n, 2)}`}>
  <ul class="phive-grid" aria-label="Projects">
    {items.map((item, i) => (
      <li class={`pcell tone-${item.tone}`} style={at(i)}>
        <a class="phex" href={`#${item.key}`} data-pcell={item.key}>
          <span class="phex-title">{item.short}</span>
          <span class="phex-field mono">{item.field}</span>
        </a>
      </li>
    ))}
    <li class="pcell pcell-missing" style={at(items.length)}>
      <a class="phex phex-missing" href={`#${missing}`} data-pcell={missing}>
        <svg class="phex-outline" viewBox="0 0 100 115.47" preserveAspectRatio="none" aria-hidden="true">
          <polygon points="50,2 98,29.9 98,85.6 50,113.5 2,85.6 2,29.9" />
        </svg>
        <span class="phex-404 mono">404</span>
        <span class="phex-title">Not on the list?</span>
      </a>
    </li>
  </ul>

  <div class="pop" data-pop>
    <button class="pop-close mono" type="button" data-pop-close hidden aria-label="Close project">Close ✕</button>
    {items.map((item) => (
      <article class="pop-item" id={item.key} data-pop-item>
        <ProjectDetails project={item.project} />
      </article>
    ))}
    <article class="pop-item pop-missing" id={missing} data-pop-item>
      <h3 class="pop-missing-title"><span class="mono">404:</span> Not on the list?</h3>
      <p>That's what the name is for. Tell us what's missing, and we'll build it.</p>
      <a class="link-arrow" href={withBase('/contact/')}>Describe what's missing <span aria-hidden="true">→</span></a>
    </article>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-phive]').forEach((hive) => {
    const pop = hive.querySelector<HTMLElement>('[data-pop]');
    const close = hive.querySelector<HTMLButtonElement>('[data-pop-close]');
    const cells = [...hive.querySelectorAll<HTMLAnchorElement>('[data-pcell]')];
    const items = [...hive.querySelectorAll<HTMLElement>('[data-pop-item]')];
    let open: string | null = null;

    const show = (key: string | null) => {
      open = key;
      for (const c of cells) {
        const on = c.dataset.pcell === open;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-expanded', String(on));
      }
      for (const it of items) it.hidden = it.id !== open;
      if (pop) pop.classList.toggle('is-open', open !== null);
      // In a tall honeycomb the popup can sit below the screen: bring it into view.
      if (open && pop) {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        pop.scrollIntoView({ block: 'nearest', behavior: reduced ? 'auto' : 'smooth' });
      }
    };

    // From here on the popups open one at a time instead of showing as a list.
    hive.classList.add('is-enhanced');
    if (close) close.hidden = false;
    show(null);

    for (const c of cells) {
      c.setAttribute('role', 'button');
      c.setAttribute('aria-controls', c.dataset.pcell ?? '');
      c.addEventListener('click', (e) => {
        e.preventDefault();
        show(open === c.dataset.pcell ? null : c.dataset.pcell ?? null);
        // The open project's address goes in the bar, without a history entry.
        history.replaceState(null, '', open ? `#${open}` : location.pathname + location.search);
      });
      c.addEventListener('keydown', (e) => {
        if (e.key === ' ') {
          e.preventDefault();
          c.click();
        }
      });
    }
    close?.addEventListener('click', () => show(null));

    // A link to /services/#<id>-<project> opens that project's popup.
    const fromHash = () => {
      const key = location.hash.slice(1);
      if (!cells.some((c) => c.dataset.pcell === key)) return;
      show(key);
      hive.scrollIntoView({ block: 'start' });
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();
    hive.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) show(null);
    });
  });
</script>

<style>
  .phive { --w: 150px; --h: calc(var(--w) * 1.1547); }
  .phive-grid {
    list-style: none; margin: 0 auto; padding: 0; width: max-content; max-width: 100%;
    display: grid;
    grid-template-columns: repeat(var(--cols-d), calc(var(--w) / 2));
    grid-template-rows: var(--tracks-d);
  }
  .pcell { grid-column: var(--cd) / span 2; grid-row: var(--rd); height: var(--h); }

  .phex {
    position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.35rem;
    width: 100%; height: 100%; padding: 0 1rem; text-align: center; text-decoration: none;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--border-strong);
    transform: scale(0.95);
    transition: background 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .phex::before {
    content: ''; position: absolute; inset: 1.5px; z-index: 0;
    clip-path: inherit; background: var(--bg-raised);
  }
  .phex > * { position: relative; z-index: 1; }
  .phex-title { font-size: 0.9rem; font-weight: 600; line-height: 1.25; color: var(--text); }
  .phex-field { font-size: 0.75rem; }
  .tone-ai .phex-field { color: var(--ai); }
  .tone-bio .phex-field { color: var(--bio); }
  /* The ring and a faint fill carry the colour: ember for AI, honey for data. */
  .tone-ai .phex { background: rgba(var(--ai-rgb), 0.5); }
  .tone-bio .phex { background: rgba(var(--bio-rgb), 0.45); }
  .tone-ai .phex::before { background: linear-gradient(rgba(var(--ai-rgb), 0.07), rgba(var(--ai-rgb), 0.07)), var(--bg-raised); }
  .tone-bio .phex::before { background: linear-gradient(rgba(var(--bio-rgb), 0.06), rgba(var(--bio-rgb), 0.06)), var(--bg-raised); }
  .tone-sw .phex-field { color: var(--text-dim); }
  .pcell .phex:hover, .pcell .phex:focus-visible, .pcell .phex.is-active { background: var(--bio); transform: scale(1); }
  .tone-ai .phex:hover, .tone-ai .phex:focus-visible, .tone-ai .phex.is-active { background: var(--ai); }
  .phex.is-active::before { background: #2b2214; }
  .phex:focus-visible { outline: none; }
  .pcell:has(.phex:hover), .pcell:has(.phex.is-active), .pcell:has(.phex:focus-visible) { filter: drop-shadow(0 0 12px var(--glow-bio)); }

  /* The 404 cell: the empty one in the comb, a dashed honey outline. */
  .pcell .phex-missing, .pcell .phex-missing:hover, .pcell .phex-missing:focus-visible, .pcell .phex-missing.is-active { background: transparent; }
  .phex-missing::before { display: none; }
  .phex > .phex-outline { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; }
  .phex-outline polygon {
    fill: rgba(var(--bio-rgb), 0.04); stroke: rgba(var(--bio-rgb), 0.7); stroke-width: 1.5; stroke-dasharray: 5 4;
    vector-effect: non-scaling-stroke; transition: fill 0.25s var(--ease), stroke 0.25s var(--ease);
  }
  .phex-missing:hover .phex-outline polygon, .phex-missing:focus-visible .phex-outline polygon, .phex-missing.is-active .phex-outline polygon {
    fill: rgba(var(--bio-rgb), 0.14); stroke: var(--bio);
  }
  .phex-404 { font-size: 1.05rem; font-weight: 500; color: var(--bio); }

  /* Without JavaScript: every popup shows, as a list under the honeycomb. */
  .pop { display: grid; gap: 1rem; margin-top: 1.4rem; }
  .pop-item { padding: clamp(1.1rem, 2.5vw, 1.6rem); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  /* With JavaScript: one popup at a time, only when a cell is chosen. */
  .is-enhanced .pop { display: none; position: relative; }
  .is-enhanced .pop.is-open { display: block; }
  .pop-item[hidden] { display: none; }

  .pop-missing { border-style: dashed; border-color: rgba(var(--bio-rgb), 0.42); background: rgba(var(--bio-rgb), 0.04); }
  .pop-missing-title { margin: 0 0 0.75rem; padding-right: 5.5rem; font-size: clamp(1.2rem, 2.2vw, 1.5rem); line-height: 1.25; }
  .pop-missing-title .mono { color: var(--bio); }
  .pop-missing p { max-width: 62ch; color: var(--text-dim); }

  .pop-close {
    position: absolute; top: 0.8rem; right: 0.8rem; z-index: 1; min-height: 32px; padding: 0 0.7rem;
    font-size: 0.75rem; color: var(--text-dim); background: transparent;
    border: 1px solid var(--border); border-radius: var(--radius-sm); cursor: pointer;
  }
  .pop-close:hover { color: var(--text); border-color: var(--border-strong); }

  @media (max-width: 640px) {
    .phive { --w: min(160px, calc((100vw - 2 * var(--gutter)) / 2.5)); }
    .phive-grid {
      grid-template-columns: repeat(var(--cols-p), calc(var(--w) / 2));
      grid-template-rows: var(--tracks-p);
    }
    .pcell { grid-column: var(--cp) / span 2; grid-row: var(--rp); }
    .phex-title { font-size: 0.85rem; }
  }

  /* One big honeycomb: seven slightly smaller cells per row where the page is wide enough. */
  @media (min-width: 1200px) {
    .phive { --w: 140px; }
    .phive-grid { grid-template-columns: repeat(var(--cols-w), calc(var(--w) / 2)); grid-template-rows: var(--tracks-w); }
    .pcell { grid-column: var(--cw) / span 2; grid-row: var(--rw); }
  }

  @media (prefers-reduced-motion: reduce) { .phex, .phex-outline polygon { transition: none; } }
</style>
