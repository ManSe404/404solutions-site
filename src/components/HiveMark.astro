---
// The logo mark: two honey cells and the empty, outlined third one.
// `stroke` thickens the outline as the mark gets smaller (brand board).
interface Props {
  size?: number;
  stroke?: number;
  color?: string;
}

const { size = 34, stroke = 1.5, color = 'var(--bio)' } = Astro.props;
const height = Math.round((size * 33) / 34);
---

<svg width={size} height={height} viewBox="0 0 34 33" aria-hidden="true">
  <polygon points="9.1,2.0 16.0,6.0 16.0,14.0 9.1,18.0 2.2,14.0 2.2,6.0" fill={color}></polygon>
  <polygon points="24.7,2.0 31.6,6.0 31.6,14.0 24.7,18.0 17.8,14.0 17.8,6.0" fill={color}></polygon>
  <polygon
    points="16.9,15.5 23.8,19.5 23.8,27.5 16.9,31.5 10.0,27.5 10.0,19.5"
    fill="none"
    stroke={color}
    stroke-width={stroke}></polygon>
</svg>
