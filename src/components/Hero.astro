---
import CombVisual from './CombVisual.astro';
import { company } from '../data/company';
import { withBase } from '../lib/url';
// The numbers that used to sit in a stats row under the hero now live in the
// "At a glance" dashboard right after it (src/components/hive/, ADR 0005).
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-grid">
    <p class="eyebrow hero-eyebrow">AI &amp; software delivery<span class="hero-reach"> · Europe &amp; US</span></p>
    <h1 id="hero-title">We build the part your team is <span class="accent">missing</span>.</h1>
    <p class="hero-lede">{company.description}</p>
    <div class="hero-visual">
      <CombVisual />
    </div>
    <div class="hero-actions">
      <a class="btn" href={withBase('/contact/')}>Start a project <span aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href={withBase('/services/')}>See what we built</a>
    </div>
    <p class="hero-led mono">Founded and led by {company.founder.name} — {company.founder.titles.join(' · ')}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(3.5rem, 9vh, 6.5rem);
  }

  /* Desktop: copy on the left, the comb on the right across all rows.
     Phone: one column, the comb between the lede and the buttons. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'eyebrow visual'
      'title   visual'
      'lede    visual'
      'actions visual'
      'led     visual';
    align-content: center;
    column-gap: clamp(2.5rem, 6vw, 4.5rem);
    row-gap: 1.5rem;
  }

  .hero-eyebrow { grid-area: eyebrow; }
  h1 { grid-area: title; }
  .hero-lede { grid-area: lede; }
  .hero-visual { grid-area: visual; align-self: center; }
  .hero-actions { grid-area: actions; }
  .hero-led { grid-area: led; }

  h1 {
    font-size: clamp(2.5rem, 5.6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  .accent {
    color: var(--bio);
  }

  .hero-lede {
    max-width: 54ch;
    font-size: 1.125rem;
    color: var(--text-dim);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.4rem;
  }

  .hero-led {
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--text-faint);
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 2.5rem;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'eyebrow' 'title' 'lede' 'visual' 'actions' 'led';
      row-gap: 1.25rem;
    }

    .hero-reach {
      display: none;
    }

    .hero-lede {
      font-size: 1rem;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      min-height: 50px;
    }
  }
</style>
