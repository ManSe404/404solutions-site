---
// Scout, the company mascot: a front-facing honey bee in the Hive palette.
// Drawn on a 64 × 64 grid so it stays legible from a 28 px avatar up to a
// 200 px illustration. Decorative by default; pass `label` when it carries
// meaning on its own.
interface Props {
  size?: number;
  label?: string;
  class?: string;
}

const { size = 64, label, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <!-- wings, behind the body -->
  <ellipse cx="16.5" cy="24" rx="11" ry="7" transform="rotate(-28 16.5 24)" fill="rgba(247,237,217,0.16)" stroke="#f7edd9" stroke-opacity="0.6" stroke-width="1.4"></ellipse>
  <ellipse cx="47.5" cy="24" rx="11" ry="7" transform="rotate(28 47.5 24)" fill="rgba(247,237,217,0.16)" stroke="#f7edd9" stroke-opacity="0.6" stroke-width="1.4"></ellipse>
  <!-- antennae -->
  <path d="M27 19.5 Q24.5 12.5 20 10" fill="none" stroke="#ffb627" stroke-width="1.8" stroke-linecap="round"></path>
  <path d="M37 19.5 Q39.5 12.5 44 10" fill="none" stroke="#ffb627" stroke-width="1.8" stroke-linecap="round"></path>
  <circle cx="20" cy="10" r="2.3" fill="#ffb627"></circle>
  <circle cx="44" cy="10" r="2.3" fill="#ffb627"></circle>
  <!-- stinger -->
  <path d="M29.6 53.2 L32 58.5 L34.4 53.2 Z" fill="#2a1c00"></path>
  <!-- body -->
  <circle cx="32" cy="36" r="18" fill="#ffb627"></circle>
  <!-- stripes: chords of the body circle, so no clip path is needed -->
  <path d="M14.45 40 H49.55 A18 18 0 0 1 47.59 45 H16.41 A18 18 0 0 1 14.45 40 Z" fill="#2a1c00"></path>
  <path d="M18.58 48 H45.42 A18 18 0 0 1 40.25 52 H23.75 A18 18 0 0 1 18.58 48 Z" fill="#2a1c00"></path>
  <!-- face -->
  <circle cx="25.5" cy="30.5" r="2.7" fill="#2a1c00"></circle>
  <circle cx="38.5" cy="30.5" r="2.7" fill="#2a1c00"></circle>
  <circle cx="26.4" cy="29.5" r="0.95" fill="#f7edd9"></circle>
  <circle cx="39.4" cy="29.5" r="0.95" fill="#f7edd9"></circle>
  <circle cx="21.2" cy="35" r="2.1" fill="#ff9c80" opacity="0.75"></circle>
  <circle cx="42.8" cy="35" r="2.1" fill="#ff9c80" opacity="0.75"></circle>
  <path d="M28.6 35 Q32 38 35.4 35" fill="none" stroke="#2a1c00" stroke-width="1.7" stroke-linecap="round"></path>
</svg>
